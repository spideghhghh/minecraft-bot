# ==========================================
# 1. إعدادات خادم ماينكرافت (Minecraft Server)
# ==========================================
# ضع هنا عنوان IP الخاص بالسيرفر أو الدومين
SERVER_HOST=your.server.ip.here

# منفذ السيرفر (الافتراضي 25565)
SERVER_PORT=25565

# إصدار السيرفر (مثال: 1.20.4)
MC_VERSION=1.20.4

# ==========================================
# 2. إعدادات حساب البوت (Bot Account)
# ==========================================
# اسم البوت داخل اللعبة
BOT_USERNAME=AdminBot

# نوع الحساب: 'offline' للسيرفرات المكركة، أو 'microsoft' للحسابات الأصلية
AUTH_TYPE=offline

# كلمة السر (مطلوبة فقط إذا كان AUTH_TYPE=microsoft)
# BOT_PASSWORD=your_password_here

# ==========================================
# 3. إعدادات موقع الويب الوهمي (Render Keep-Alive)
# ==========================================
# منفذ سيرفر Express (Render يحدد هذا المنفذ تلقائياً عبر المتغير PORT)
PORT=3000

# ==========================================
# 4. إعدادات الفعاليات والأوامر
# ==========================================
# المدة الزمنية بين كل فعالية وأخرى (بالدقائق)
EVENT_INTERVAL_MINUTES=15

# التردد الزمني لحركة Anti-AFK (بالثواني)
ANTI_AFK_INTERVAL_SECONDS=180

# رمزة العملة المستخدمة في السيرفر (تنسجم مع BankPlus / Vault)
CURRENCY_SYMBOL=$
